# Local cx proxy with the GPT-6 and GPT-6.1 Codex models.
# Model id = cx/gpt-<version>-<tier>-<effort>. Tiers: astra > sol > terra > luna. Sol and Terra are 6.1.
# Effort suffix: low | medium | high | xhigh | max | ultra.

export ANTHROPIC_BASE_URL="http://localhost:20128"
export ANTHROPIC_AUTH_TOKEN=""                          # key from the proxy dashboard

export ANTHROPIC_MODEL="cx/gpt-6.1-sol-high"              # session default
export ANTHROPIC_DEFAULT_FABLE_MODEL="cx/gpt-6-astra-high"
export ANTHROPIC_DEFAULT_OPUS_MODEL="cx/gpt-6.1-sol-xhigh"
export ANTHROPIC_DEFAULT_SONNET_MODEL="cx/gpt-6.1-terra-medium"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="cx/gpt-6-luna-low" # haiku and background calls
export ANTHROPIC_SMALL_FAST_MODEL="cx/gpt-6-luna-low"

export CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000     # all four models have ~1.05M
export CLAUDE_CODE_AUTO_COMPACT_WINDOW=270000     # long-context pricing starts >272K input
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 # a GPT-6 session sends nothing to Anthropic
