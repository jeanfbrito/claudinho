# claudinho provider. Copy to ~/.config/claudinho/providers/<name>.env (600).
# Every line is a plain export; claudinho sources this file in a subshell
# right before it starts Claude Code, so nothing here touches your shell.

export ANTHROPIC_BASE_URL="https://api.example.com/anthropic"
export ANTHROPIC_AUTH_TOKEN=""              # the service's API key

export ANTHROPIC_MODEL="some-model"          # session default
export ANTHROPIC_DEFAULT_OPUS_MODEL="some-model"
export ANTHROPIC_DEFAULT_SONNET_MODEL="some-model"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="some-small-model"   # background calls
export ANTHROPIC_SMALL_FAST_MODEL="some-small-model"

# Optional:
# export CLAUDE_CODE_MAX_CONTEXT_TOKENS=200000      # real window of the model
# export CLAUDE_CODE_AUTO_COMPACT_WINDOW=200000     # compact at this size
# export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 # no telemetry/updates this run
# export API_TIMEOUT_MS=3000000                     # slow providers
# export CLAUDINHO_FLAGS="--chrome"                 # replaces the default
#   claudinho flags (--dangerously-skip-permissions --chrome); "" for none
